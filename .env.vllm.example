# Docker inference service configuration, separate from the Next.js app.
# Copy to .env.vllm. Use the same key in Admin > Providers > vllm.
VLLM_API_KEY=
VLLM_IMAGE=vllm/vllm-openai:v0.32.0
# Starting profile for a company GPU with sufficient VRAM; tune after measuring.
# For an 8 GB development GPU try Qwen/Qwen3-1.7B, 4096 context, 4 sequences.
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=32
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_TENSOR_PARALLEL_SIZE=1
# These parsers are for the Qwen3 model above; change them for other families.
VLLM_TOOL_CALL_PARSER=hermes
VLLM_REASONING_PARSER=qwen3
# Loopback by default. For a separate app host use a private LAN address and firewall.
VLLM_BIND_HOST=127.0.0.1
VLLM_PORT=8000
# Optional for gated Hugging Face models (requires an accepted model license).
HF_TOKEN=
