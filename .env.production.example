# Copy to .env.production on the Linux GPU server. Never commit real secrets.
SITE_ADDRESS=ai.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate each separately: openssl rand -hex 32. Keep these stable and back them up.
SESSION_SECRET=
PROVIDER_KEY_SECRET=
VLLM_API_KEY=

# Initial single RTX 5090 profile; measure real workloads before raising concurrency.
VLLM_IMAGE=vllm/vllm-openai:v0.32.0
VLLM_MODEL=Qwen/Qwen3-8B
# Qwen3-8B's native maximum; coding clients such as OpenCode need the room.
# If vLLM reports too little KV cache at startup, lower to 24576 or 16384.
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=8
VLLM_MAX_CONCURRENT=8
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_TOOL_CALL_PARSER=hermes
VLLM_REASONING_PARSER=qwen3
VLLM_BIND_HOST=127.0.0.1
VLLM_PORT=8000
HF_TOKEN=
LLM_MAX_QUEUE=64
LLM_QUEUE_TIMEOUT_MS=30000
LLM_REQUEST_TIMEOUT_MS=180000
