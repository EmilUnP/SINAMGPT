# Cookie signing secret — change once, then keep stable.
# Also encrypts provider API keys unless PROVIDER_KEY_SECRET is set.
# Rotating this without a dedicated provider secret invalidates stored keys.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional dedicated secret for provider API-key encryption (AES-256-GCM).
# Prefer this so rotating SESSION_SECRET does not lock you out of stored keys.
# PROVIDER_KEY_SECRET=

# Seeds the default vLLM provider when it does not already exist.
# Existing installs: edit URL/key/concurrency in Admin > Providers.
# Server root or /v1 URL accepted; use the GPU server's LAN address if remote.
VLLM_BASE_URL=http://127.0.0.1:8000
# Must match the server key. Encrypted when first seeded into SQLite.
VLLM_API_KEY=
# Full in-flight generations per app process. 0 delegates admission to vLLM.
VLLM_MAX_CONCURRENT=32
# Set 1 only after starting vLLM with a matching tool-call parser.
VLLM_TOOL_CALLING=0
LLM_MAX_QUEUE=256
LLM_QUEUE_TIMEOUT_MS=30000
LLM_REQUEST_TIMEOUT_MS=180000
# Optional qualified app id, e.g. vllm:Qwen/Qwen3-8B. Blank uses an activated model.
DEFAULT_MODEL=

# High admin account — created automatically if missing (password min 10 chars; do not leave the example)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Guest try-chat defaults (admin editable in /admin; logged-in = unlimited)
GUEST_DAILY_LIMIT=5
GUEST_MAX_MESSAGE_CHARS=2000

# Set to 1 only when a reverse proxy you control sets X-Forwarded-For / X-Real-IP.
# Leave unset on a direct LAN bind so clients cannot spoof rate-limit identity.
# TRUST_PROXY=

# Public origin used in password-reset links (optional; request origin is used if unset).
# APP_URL=http://localhost:3055

# Optional seed for Admin → Settings → Internet search when using SearXNG.
# SQLite remains authoritative after the first save.
# SEARXNG_BASE_URL=http://127.0.0.1:8080
