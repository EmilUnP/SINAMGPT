# Cookie signing secret — change this in production / company use
SESSION_SECRET=change-me-to-a-long-random-string

# Which LLM backends to use (comma-separated). Models are discovered in parallel.
# Examples: ollama | vllm | ollama,vllm
LLM_BACKENDS=ollama

# Ollama API (default local install)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Keep model weights warm in VRAM between chats (speed). Examples: 5m, 30m, -1
OLLAMA_KEEP_ALIVE=30m

# vLLM OpenAI-compatible server (enable with LLM_BACKENDS=ollama,vllm or vllm)
VLLM_BASE_URL=http://127.0.0.1:8000
# Optional bearer token if your vLLM / proxy requires auth
# VLLM_API_KEY=

# Optional default model (must exist on an enabled backend)
DEFAULT_MODEL=gemma3:4b

# High admin account — created automatically if missing
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminChangeMe123!

# Guest try-chat defaults (admin editable in /admin; logged-in = unlimited)
GUEST_DAILY_LIMIT=5
GUEST_MAX_MESSAGE_CHARS=2000
